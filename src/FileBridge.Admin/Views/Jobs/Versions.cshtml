@model List<JobVersion>
@{ ViewData["Title"] = "Job versions"; }
<h1>Versions — @ViewBag.JobName</h1>
<table class="fb-table">
    <thead><tr><th>Version</th><th>Created (UTC)</th><th>By</th><th></th></tr></thead>
    <tbody>
    @foreach (var v in Model)
    {
        <tr>
            <td>@v.Version</td>
            <td class="fb-mono">@v.CreatedUtc.ToString("u")</td>
            <td>@v.CreatedBy</td>
            <td><form method="post" asp-action="Rollback" asp-route-id="@ViewBag.JobId" asp-route-version="@v.Version"><button type="submit" class="btn-fb secondary">Roll back to this version</button></form></td>
        </tr>
    }
    </tbody>
</table>
<p><a class="fb-textlink" asp-action="Edit" asp-route-id="@ViewBag.JobId">Back to job</a></p>
