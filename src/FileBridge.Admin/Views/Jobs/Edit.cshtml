@model FileBridge.Admin.Models.JobEditModel
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Transfer Job" : "Create Transfer Job";
    ViewData["ActiveNav"] = "jobs";
    var endpoints = (IEnumerable<dynamic>)(ViewData["Endpoints"] ?? Enumerable.Empty<dynamic>());
    var encryptionProfiles = (IEnumerable<dynamic>)(ViewData["EncryptionProfiles"] ?? Enumerable.Empty<dynamic>());
}

<div class="fb-page-header">
    <div class="fb-page-title-group">
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1>@(Model.Id > 0 ? "Edit Transfer Job" : "Create Transfer Job")</h1>
            @if (Model.Id > 0) {
                <span class="fb-badge @(Model.IsEnabled ? (Model.IsPaused ? "warn" : "ok") : "muted")">
                    @(Model.IsEnabled ? (Model.IsPaused ? "Paused" : "Active") : "Disabled")
                </span>
            }
        </div>
        <p class="fb-page-subtitle">Configure Quartz scheduling, folder path mappings, crypto filters, and delivery SLAs.</p>
    </div>
    <div class="fb-page-actions">
        @if (Model.Id > 0) {
            <button type="button" class="btn-fb secondary" data-fb-action="post-poll" data-fb-url="/Jobs/DryRun/@Model.Id" data-fb-render="dryrun" data-fb-title="Dry Run: @Model.Name">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <span>Dry Run</span>
            </button>
            <button type="button" class="btn-fb primary" data-fb-action="post-poll" data-fb-url="/Jobs/RunNow/@Model.Id" data-fb-render="message" data-fb-title="Run Now: @Model.Name" data-fb-confirm="Trigger transfer execution immediately for @Model.Name?">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Run Now</span>
            </button>
            <a class="btn-fb secondary" href="/Jobs/Versions/@Model.Id">Snapshots</a>
            <a class="btn-fb secondary" href="/Jobs/Export/@Model.Id">Export</a>
        }
        <a class="btn-fb secondary" href="/Jobs">Back to List</a>
    </div>
</div>

<form method="post" action="/Jobs/Save" class="fb-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <!-- 1. General & Routing -->
    <div class="fb-card mb-4">
        <h2 class="fb-card-title">General &amp; Routing</h2>
        <p class="fb-card-desc">Identify the pipeline and choose the connected source and destination endpoints.</p>

        <div class="row mb-3">
            <div>
                <label>Job Name <span class="text-danger">*</span></label>
                <input name="Name" value="@Model.Name" required placeholder="e.g. Daily_Payroll_SFTP_Ingest" />
            </div>
            <div>
                <label>Operational Description</label>
                <input name="Description" value="@Model.Description" placeholder="Purpose, owner, ticket ID, or escalation path..." />
            </div>
        </div>

        <div class="row mb-3">
            <div>
                <label>Source Connection Endpoint <span class="text-danger">*</span></label>
                <select name="SourceEndpointId" id="srcEndpointSelect">
                    @foreach (var e in endpoints) {
                        <option value="@e.Id" selected="@(Model.SourceEndpointId == e.Id)">@e.Name</option>
                    }
                </select>
            </div>
            <div>
                <label>Destination Connection Endpoint <span class="text-danger">*</span></label>
                <select name="DestinationEndpointId" id="dstEndpointSelect">
                    @foreach (var e in endpoints) {
                        <option value="@e.Id" selected="@(Model.DestinationEndpointId == e.Id)">@e.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="d-flex align-items-center gap-4 pt-2">
            <div class="checkline">
                <input name="IsEnabled" value="true" type="checkbox" id="jobEnabled" @(Model.IsEnabled ? "checked" : "") />
                <label for="jobEnabled"><strong>Job Active</strong> (Enabled in Quartz engine)</label>
            </div>
            <div class="checkline">
                <input name="IsPaused" value="true" type="checkbox" id="jobPaused" @(Model.IsPaused ? "checked" : "") />
                <label for="jobPaused"><strong>Paused</strong> (Temporarily hold schedule triggers)</label>
            </div>
        </div>
    </div>

    <!-- 2. Quartz Schedule -->
    <div class="fb-card mb-4">
        <h2 class="fb-card-title">Quartz Schedule &amp; Execution Window</h2>
        <div class="row mb-3">
            <div>
                <label>Cron Expression (Quartz 6-part format)</label>
                <input name="CronExpression" value="@Model.CronExpression" class="fb-mono" placeholder="0 0 2 * * ? (Every day at 2:00 AM)" />
            </div>
            <div>
                <label>Polling Interval (Seconds, if not Cron)</label>
                <input name="IntervalSeconds" type="number" value="@Model.IntervalSeconds" placeholder="300" />
            </div>
        </div>
    </div>

    <!-- 3. Folder Mappings -->
    <div class="fb-card mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="fb-card-title">Folder Mappings</h2>
                <p class="fb-card-desc">Define directory pairs. Use 'Browse' to explore remote filesystem trees.</p>
            </div>
            <button type="button" class="btn-fb secondary sm" data-fb-add-row="folders">
                <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Add Folder Map</span>
            </button>
        </div>

        <div id="folders">
            @for (int i = 0; i < Model.FolderMaps.Count; i++) {
                var f = Model.FolderMaps[i];
                <div class="row fb-repeat-row mb-3 align-items-end">
                    <div style="flex: 2;">
                        <label>Source Subfolder</label>
                        <div class="input-group">
                            <input name="FolderMaps[@i].SourceSubfolder" value="@f.SourceSubfolder" class="form-control fb-mono" placeholder="e.g. /inbound" />
                            <button type="button" class="btn btn-outline-secondary" data-fb-browse="#srcEndpointSelect">Browse</button>
                        </div>
                    </div>
                    <div style="flex: 2;">
                        <label>Destination Subfolder</label>
                        <div class="input-group">
                            <input name="FolderMaps[@i].DestinationSubfolder" value="@f.DestinationSubfolder" class="form-control fb-mono" placeholder="e.g. /archive" />
                            <button type="button" class="btn btn-outline-secondary" data-fb-browse="#dstEndpointSelect">Browse</button>
                        </div>
                    </div>
                    <div class="checkline" style="margin-bottom: 8px;">
                        <input name="FolderMaps[@i].Recursive" value="true" type="checkbox" id="rec_@i" @(f.Recursive ? "checked" : "") />
                        <label for="rec_@i">Recursive</label>
                    </div>
                    <div style="margin-bottom: 6px;">
                        <button type="button" class="btn-fb danger sm" data-fb-remove-row>Remove</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 4. Processing & Crypto Profile -->
    <div class="fb-card mb-4">
        <h2 class="fb-card-title">Processing &amp; Cryptography</h2>
        <div class="row mb-3">
            <div>
                <label>Encryption Profile</label>
                <select name="EncryptionProfileId">
                    <option value="">None (Plaintext delivery)</option>
                    @foreach (var p in encryptionProfiles) {
                        <option value="@p.Id" selected="@(Model.EncryptionProfileId == p.Id)">@p.Name</option>
                    }
                </select>
            </div>
            <div>
                <label>Duplicate Handling Policy</label>
                <select name="DuplicatePolicyId">
                    <option value="1" selected="@(Model.DuplicatePolicyId == 1)">Overwrite existing file</option>
                    <option value="2" selected="@(Model.DuplicatePolicyId == 2)">Skip transfer</option>
                    <option value="3" selected="@(Model.DuplicatePolicyId == 3)">Fail transfer</option>
                    <option value="4" selected="@(Model.DuplicatePolicyId == 4)">Append timestamp suffix</option>
                </select>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-3">
        <button type="submit" class="btn-fb primary">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Save Job Configuration</span>
        </button>
        <a class="btn-fb secondary" href="/Jobs">Cancel</a>
    </div>
</form>

<template id="folders-template">
    <div class="row fb-repeat-row mb-3 align-items-end">
        <div style="flex: 2;">
            <label>Source Subfolder</label>
            <div class="input-group">
                <input name="FolderMaps[0].SourceSubfolder" class="form-control fb-mono" placeholder="e.g. /inbound" />
                <button type="button" class="btn btn-outline-secondary" data-fb-browse="#srcEndpointSelect">Browse</button>
            </div>
        </div>
        <div style="flex: 2;">
            <label>Destination Subfolder</label>
            <div class="input-group">
                <input name="FolderMaps[0].DestinationSubfolder" class="form-control fb-mono" placeholder="e.g. /archive" />
                <button type="button" class="btn btn-outline-secondary" data-fb-browse="#dstEndpointSelect">Browse</button>
            </div>
        </div>
        <div class="checkline" style="margin-bottom: 8px;">
            <input name="FolderMaps[0].Recursive" value="true" type="checkbox" id="rec_new" />
            <label for="rec_new">Recursive</label>
        </div>
        <div style="margin-bottom: 6px;">
            <button type="button" class="btn-fb danger sm" data-fb-remove-row>Remove</button>
        </div>
    </div>
</template>
