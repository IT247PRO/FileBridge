@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "System Settings";
    ViewData["ActiveNav"] = "settings";
}

<div class="fb-page-header">
    <div class="fb-page-title-group">
        <h1>Global Cluster Settings</h1>
        <p class="fb-page-subtitle">Configure throughput limits, retention intervals, retry backoffs, and notification hooks.</p>
    </div>
</div>

<div class="fb-card">
    <div class="fb-card-header">
        <h3 class="fb-card-title">Cluster Parameters</h3>
        <span class="text-muted small">Synchronized across Worker nodes via tblGlobalSetting</span>
    </div>
    <table class="fb-table">
        <thead>
            <tr>
                <th>Setting Key</th>
                <th>Current Value</th>
                <th>Description</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model) {
                <tr>
                    <td><code class="fb-mono fw-bold">@s.Key</code></td>
                    <td><span class="fb-badge info fb-mono">@s.Value</span></td>
                    <td class="text-muted">@s.Description</td>
                    <td class="text-end">
                        <button type="button" class="btn-fb secondary sm">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
