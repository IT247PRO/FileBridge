@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Four-Eyes Approvals";
    ViewData["ActiveNav"] = "approvals";
}

<div class="fb-page-header">
    <div class="fb-page-title-group">
        <h1>Pending Approvals (Dual Control)</h1>
        <p class="fb-page-subtitle">Jobs targeting classified destinations require secondary operator authorization before release.</p>
    </div>
</div>

<div class="fb-table-container">
    <div class="fb-table-toolbar">
        <span class="fw-bold">Pending Review Queue (@Model.Count())</span>
        <span class="text-muted small">Dual-authorization policy enforced</span>
    </div>

    <table class="fb-table">
        <thead>
            <tr>
                <th>Job &amp; Trigger Reason</th>
                <th>Requested By</th>
                <th>Target Endpoint</th>
                <th>Status</th>
                <th>Requested At (UTC)</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any()) {
            <tr>
                <td colspan="6" class="fb-empty">
                    <div>No pending approvals in queue. All systems operating normally.</div>
                </td>
            </tr>
        } else {
            @foreach (var a in Model) {
                <tr>
                    <td>
                        <div class="fw-bold text-main">@a.JobName</div>
                        <div class="text-muted small">@a.Reason</div>
                    </td>
                    <td>
                        <div class="fb-mono small">@a.RequestedBy</div>
                    </td>
                    <td>
                        <span class="fb-badge info">@a.TargetEndpoint</span>
                    </td>
                    <td>
                        <span class="fb-badge warn">Pending Review</span>
                    </td>
                    <td class="fb-mono text-muted small">
                        @a.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex align-items-center gap-1">
                            <form method="post" action="/Approvals/Approve/@a.Id" class="d-inline">
                                <button type="submit" class="btn-fb primary sm">Approve</button>
                            </form>
                            <form method="post" action="/Approvals/Reject/@a.Id" class="d-inline">
                                <button type="submit" class="btn-fb danger sm">Reject</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
