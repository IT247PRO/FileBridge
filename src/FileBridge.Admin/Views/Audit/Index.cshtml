@model List<ConfigAudit>
@{ ViewData["Title"] = "Audit log"; var entities = (List<string>)ViewBag.Entities; }
<h1>Audit log</h1>
<form method="get" class="mb-3">
    <select name="entity" asp-items="@(new SelectList(entities))"><option value="">(all)</option></select>
    <button type="submit" class="btn-fb secondary">Filter</button>
</form>
<table class="fb-table">
    <thead><tr><th>Changed (UTC)</th><th>Entity</th><th>Key</th><th>Action</th><th>By</th></tr></thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td class="fb-mono">@a.ChangedUtc.ToString("u")</td>
            <td>@a.EntityName</td>
            <td>@a.EntityKey</td>
            <td><span class="fb-badge @(a.AuditActionId == AuditAction.Deleted ? "fail" : a.AuditActionId == AuditAction.Added ? "ok" : "warn")">@a.AuditActionId</span></td>
            <td>@a.ChangedBy</td>
        </tr>
    }
    </tbody>
</table>
<p class="fb-empty">@ViewBag.Total total row(s), page @ViewBag.Page.</p>
