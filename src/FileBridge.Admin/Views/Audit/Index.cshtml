@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "System Audit Log";
    ViewData["ActiveNav"] = "audit";
}

<div class="fb-page-header">
    <div class="fb-page-title-group">
        <h1>Immutable Audit Log</h1>
        <p class="fb-page-subtitle">Cryptographically verified operator activity, job modifications, and security overrides.</p>
    </div>
</div>

<div class="fb-table-container">
    <table class="fb-table">
        <thead>
            <tr>
                <th>Timestamp (UTC)</th>
                <th>Principal / Actor</th>
                <th>Action</th>
                <th>Target Entity</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model) {
                <tr>
                    <td class="fb-mono text-muted small">@log.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td><span class="fb-mono fw-semibold">@log.Actor</span></td>
                    <td><span class="fb-badge ok">@log.Action</span></td>
                    <td><span class="fw-bold">@log.Entity</span></td>
                    <td class="text-muted small">@log.Details</td>
                </tr>
            }
        </tbody>
    </table>
</div>
