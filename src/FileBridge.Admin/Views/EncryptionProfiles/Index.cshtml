@model List<EncryptionProfile>
@{ ViewData["Title"] = "Encryption profiles"; }
<page-header title="Encryption profiles">
    <a class="btn-fb" asp-action="Create"><i class="bi bi-plus-lg"></i> Add profile</a>
</page-header>
@if (TempData["GeneratedAesKey"] is string key)
{
    <div class="fb-card card-warn">
        <strong>New AES key generated — copy it now, it will not be shown again:</strong>
        <div class="fb-mono break-all mt-2">@key</div>
    </div>
}
<div class="fb-card">
<table class="fb-table">
    <thead><tr><th>Name</th><th>Operation</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr><td>@p.Name</td><td>@p.EncryptionOperationId</td><td><a class="fb-textlink" asp-action="Edit" asp-route-id="@p.Id">Edit</a></td></tr>
    }
    </tbody>
</table>
</div>
