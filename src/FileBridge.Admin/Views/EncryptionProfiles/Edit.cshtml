@model EncryptionProfileEditModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add encryption profile" : "Edit encryption profile"; }
<h1>@ViewData["Title"]</h1>
<form method="post" asp-action="Save" class="fb-form">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RowVersion" />
    <div class="row">
        <div><label>Name</label><input asp-for="Name" /></div>
        <div><label>Operation</label><select asp-for="EncryptionOperationId" asp-items="Html.GetEnumSelectList<EncryptionOperation>()"></select></div>
    </div>
    <p class="fb-empty pad-tight">
        @(Model.HasStoredKeys ? "Keys are already stored for this profile; leave fields blank to keep them." : "For AES, leave the key field blank and a key will be generated on save.")
    </p>
    <div><label>PGP public key (armored)</label><textarea asp-for="PublicKey" rows="4" class="fb-mono"></textarea></div>
    <div><label>PGP private key (armored)</label><textarea asp-for="PrivateKey" rows="4" class="fb-mono"></textarea></div>
    <div><label>Passphrase</label><input asp-for="Passphrase" type="password" autocomplete="new-password" /></div>
    <div class="row">
        <div><label>Output extension</label><input asp-for="OutputExtension" placeholder=".pgp" /></div>
        <div class="checkline mt-4"><input asp-for="StripExtensionOnDecrypt" type="checkbox" /><label asp-for="StripExtensionOnDecrypt">Strip extension on decrypt</label></div>
    </div>
    <div class="checkline"><input asp-for="ArmorOutput" type="checkbox" /><label asp-for="ArmorOutput">ASCII-armor PGP output</label></div>
    <div class="mt-3"><button type="submit" class="btn-fb">Save</button> <a class="fb-textlink" asp-action="Index">Cancel</a></div>
</form>
