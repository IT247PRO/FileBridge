@model TransferHistory
@{ ViewData["Title"] = "Transfer details"; }
<h1>@Model.FileName</h1>
<div class="fb-card">
    <table class="fb-table">
        <tr><th>Job</th><td>@Model.Job?.Name</td></tr>
        <tr><th>Source path</th><td class="fb-mono">@Model.SourcePath</td></tr>
        <tr><th>Destination path</th><td class="fb-mono">@Model.DestinationPath</td></tr>
        <tr><th>Status</th><td>@Model.TransferStatusId</td></tr>
        <tr><th>Attempts</th><td>@Model.AttemptCount</td></tr>
        <tr><th>Started (UTC)</th><td>@Model.StartedUtc.ToString("u")</td></tr>
        <tr><th>Completed (UTC)</th><td>@(Model.CompletedUtc?.ToString("u") ?? "-")</td></tr>
        <tr><th>Duration</th><td>@(Model.DurationMs is null ? "-" : $"{Model.DurationMs} ms")</td></tr>
        <tr><th>Node</th><td>@Model.NodeName</td></tr>
        <tr><th>Triggered by</th><td>@Model.TriggeredBy</td></tr>
        @if (Model.ErrorMessage is not null) { <tr><th>Error</th><td>@Model.ErrorMessage</td></tr> }
    </table>
</div>
@if (Model.TransferStatusId == TransferStatus.Failed)
{
    <form method="post" asp-action="Reprocess" asp-route-id="@Model.Id"><button type="submit" class="btn-fb secondary">Reprocess on next run</button></form>
}
<p><a class="fb-textlink" asp-action="Index">Back to history</a></p>
