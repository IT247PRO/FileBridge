@model List<TransferHistory>
@{ ViewData["Title"] = "History"; var jobs = (List<Job>)ViewBag.Jobs; }
<h1>Transfer history</h1>
<form method="get" class="fb-form d-flex gap-3 align-items-end">
    <div><label>Job</label>
        <select name="jobId" asp-items="@(new SelectList(jobs, "Id", "Name", ViewBag.JobId))"><option value="">(all)</option></select>
    </div>
    <div><label>Status</label>
        <select name="status" asp-items="Html.GetEnumSelectList<TransferStatus>()"><option value="">(all)</option></select>
    </div>
    <div><button type="submit" class="btn-fb secondary">Filter</button></div>
    <div><a class="fb-textlink" asp-action="ExportCsv" asp-route-jobId="@ViewBag.JobId" asp-route-status="@ViewBag.Status">Export CSV</a></div>
</form>

<table class="fb-table mt-3">
    <thead><tr><th>Started (UTC)</th><th>Job</th><th>File</th><th>Status</th><th>Size</th><th>Duration</th></tr></thead>
    <tbody>
    @foreach (var h in Model)
    {
        var badge = h.TransferStatusId switch {
            TransferStatus.Succeeded => "ok", TransferStatus.Failed => "fail",
            TransferStatus.Quarantined => "quarantine", TransferStatus.InProgress => "warn", _ => "muted" };
        <tr>
            <td class="fb-mono">@h.StartedUtc.ToString("u")</td>
            <td>@h.Job?.Name</td>
            <td><a class="fb-textlink" asp-action="Details" asp-route-id="@h.Id">@h.FileName</a></td>
            <td><span class="fb-badge @badge">@h.TransferStatusId</span></td>
            <td>@h.SizeBytes</td>
            <td>@(h.DurationMs is null ? "-" : $"{h.DurationMs} ms")</td>
        </tr>
    }
    </tbody>
</table>
<p class="fb-empty">@ViewBag.Total total row(s), page @ViewBag.Page.</p>
