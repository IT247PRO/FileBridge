@model List<Endpoint>
@{ ViewData["Title"] = "Endpoints"; }
<page-header title="Endpoints">
    <a class="btn-fb" asp-action="Create"><i class="bi bi-plus-lg"></i> Add endpoint</a>
</page-header>
<div class="fb-card">
<table class="fb-table">
    <thead><tr><th>Name</th><th>Type</th><th>Host / Base path</th><th>Enabled</th><th></th></tr></thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Name</td>
            <td>@e.EndpointTypeId</td>
            <td class="fb-mono">@(e.Host ?? e.BaseUrl) @e.BasePath</td>
            <td><span class="fb-badge @(e.IsEnabled ? "ok" : "muted")">@(e.IsEnabled ? "Enabled" : "Disabled")</span></td>
            <td class="text-nowrap">
                <button class="btn-fb secondary" data-fb-action data-fb-url="/Endpoints/TestConnection/@e.Id" data-fb-title="Test connection: @e.Name" data-fb-render="test">Test</button>
                <a class="fb-textlink ms-2" asp-action="Edit" asp-route-id="@e.Id">Edit</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
