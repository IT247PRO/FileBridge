<%- include('../partials/header') %>

<div class="fb-page-header">
    <div class="fb-page-title-group">
        <h1>Connection Endpoints</h1>
        <p class="fb-page-subtitle">Manage secure connections, network shares, SFTP servers, and API connectors.</p>
    </div>
    <div class="fb-page-actions">
        <a class="btn-fb primary" href="/Endpoints/Create">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Add Endpoint</span>
        </a>
    </div>
</div>

<div class="fb-table-container">
    <div class="fb-table-toolbar">
        <div class="fb-table-filter-group">
            <button type="button" class="btn-fb secondary sm active" data-fb-filter-tab="all" data-fb-filter-target="fb-endpoints-table">All Endpoints (<%= endpoints ? endpoints.length : 0 %>)</button>
            <button type="button" class="btn-fb secondary sm" data-fb-filter-tab="sftp" data-fb-filter-target="fb-endpoints-table">SFTP</button>
            <button type="button" class="btn-fb secondary sm" data-fb-filter-tab="smb" data-fb-filter-target="fb-endpoints-table">SMB / Shares</button>
            <button type="button" class="btn-fb secondary sm" data-fb-filter-tab="https" data-fb-filter-target="fb-endpoints-table">HTTPS API</button>
        </div>
        <span class="text-muted small">Tested across cluster nodes</span>
    </div>

    <table class="fb-table" id="fb-endpoints-table">
        <thead>
            <tr>
                <th>Endpoint Name</th>
                <th>Protocol</th>
                <th>Target Host / Base Path</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        <% if (!endpoints || endpoints.length === 0) { %>
            <tr>
                <td colspan="5" class="fb-empty">
                    <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="text-muted mb-2">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
                    </svg>
                    <div>No connection endpoints configured. Click "Add Endpoint" to register a host.</div>
                </td>
            </tr>
        <% } else { %>
            <% endpoints.forEach(function(e) { 
                var typeName = (endpointTypeNames[e.endpointTypeId] || 'Smb').toLowerCase();
            %>
                <tr data-filter="<%= typeName %>">
                    <td>
                        <div class="fw-bold text-main">
                            <a href="/Endpoints/Edit/<%= e.id %>" class="fb-textlink" style="color: var(--fb-text-main); font-weight: 700;">
                                <%= e.name %>
                            </a>
                        </div>
                        <% if (e.notes) { %>
                            <div class="text-muted small"><%= e.notes %></div>
                        <% } %>
                    </td>
                    <td>
                        <% if (e.endpointTypeId === 2) { %>
                            <span class="fb-proto-tag sftp">SFTP</span>
                        <% } else if (e.endpointTypeId === 1) { %>
                            <span class="fb-proto-tag smb">SMB</span>
                        <% } else if (e.endpointTypeId === 3) { %>
                            <span class="fb-proto-tag https">HTTPS</span>
                        <% } else { %>
                            <span class="fb-proto-tag local">LOCAL</span>
                        <% } %>
                    </td>
                    <td>
                        <div class="fb-mono small text-break">
                            <%= e.host || e.baseUrl || '' %><%= (e.port ? ':' + e.port : '') %>
                            <span class="text-muted"><%= e.basePath || '' %></span>
                        </div>
                    </td>
                    <td>
                        <span class="fb-badge <%= e.isEnabled ? 'ok' : 'muted' %>">
                            <%= e.isEnabled ? 'Operational' : 'Disabled' %>
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex align-items-center gap-1">
                            <button type="button" class="btn-fb secondary sm" data-fb-action="post-poll" data-fb-url="/Endpoints/TestConnection/<%= e.id %>" data-fb-render="test" data-fb-title="Test Connectivity: <%= e.name %>">
                                <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                <span>Test</span>
                            </button>
                            <button type="button" class="btn-fb secondary sm" data-fb-explore="<%= e.id %>" data-fb-title="Browse Filesystem: <%= e.name %>">
                                <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                                </svg>
                                <span>Browse</span>
                            </button>
                            <a class="btn-fb primary sm" href="/Endpoints/Edit/<%= e.id %>">
                                <span>Edit</span>
                            </a>
                        </div>
                    </td>
                </tr>
            <% }); %>
        <% } %>
        </tbody>
    </table>
</div>

<%- include('../partials/footer') %>
