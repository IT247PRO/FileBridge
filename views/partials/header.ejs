<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : 'fb-token' %>" />
    <title><%= typeof title !== 'undefined' ? title : 'FileBridge' %> - FileBridge Admin</title>
    <meta name="description" content="Enterprise file transfer bridge service with jobs, history, quarantine, endpoints, and approval workflows." />
    <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'FileBridge' %> - FileBridge" />
    <meta property="og:description" content="Enterprise file transfer bridge service with jobs, history, quarantine, endpoints, and approval workflows." />
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <div class="fb-shell">
        <!-- AirFlow Modern Left Nav Sidebar -->
        <aside class="fb-sidebar">
            <a href="/" class="fb-sidebar-brand">
                <div class="fb-sidebar-logo">FB</div>
                <span class="fb-sidebar-brand-text">FileBridge</span>
                <span class="fb-sidebar-brand-tag">MFT</span>
            </a>

            <div class="fb-sidebar-content">
                <!-- AirFlow Profile Card -->
                <div class="fb-profile-card">
                    <div class="fb-profile-avatar">AD</div>
                    <div class="overflow-hidden">
                        <div class="fb-profile-name text-truncate"><%= typeof currentUser !== 'undefined' && currentUser ? currentUser : 'AGENCY\\admin' %></div>
                        <div class="fb-profile-sub">Cluster Administrator</div>
                    </div>
                </div>

                <!-- AirFlow Pipeline Load Telemetry -->
                <div class="fb-telemetry-widget">
                    <div class="fb-telemetry-title">
                        <span>Pipeline Load (24h)</span>
                        <span class="text-success fw-bold">99.4%</span>
                    </div>
                    <div class="fb-telemetry-progress">
                        <div class="bar-ok" title="Safe transfers"></div>
                        <div class="bar-warn" title="Queued/Retrying"></div>
                        <div class="bar-fail" title="Held/Quarantine"></div>
                    </div>
                    <div class="fb-telemetry-legend">
                        <span>1,420 Safe</span>
                        <span>14 Pending</span>
                        <span>0 Quarantined</span>
                    </div>
                </div>

                <!-- AirFlow Signature Grid Menu -->
                <div class="grid-menu-heading">Applications &amp; Modules</div>
                <ul class="grid-menu app-menu">
                    <!-- Dashboard -->
                    <li>
                        <a href="/" class="<%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? 'active' : '' %>" title="Dashboard">
                            <div class="app-card">
                                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                                </svg>
                            </div>
                            <div class="app-label">Dashboard</div>
                        </a>
                    </li>

                    <!-- Jobs -->
                    <li>
                        <a href="/Jobs" class="<%= typeof activeNav !== 'undefined' && activeNav === 'jobs' ? 'active' : '' %>" title="Transfer Jobs">
                            <div class="app-card">
                                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                </svg>
                            </div>
                            <div class="app-label">Jobs</div>
                        </a>
                    </li>

                    <!-- History -->
                    <li>
                        <a href="/History" class="<%= typeof activeNav !== 'undefined' && activeNav === 'history' ? 'active' : '' %>" title="Transfer History">
                            <div class="app-card">
                                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="app-label">History</div>
                        </a>
                    </li>

                    <!-- Quarantine -->
                    <li>
                        <a href="/Quarantine" class="<%= typeof activeNav !== 'undefined' && activeNav === 'quarantine' ? 'active' : '' %>" title="Quarantine Vault">
                            <div class="app-card">
                                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            </div>
                            <div class="app-label">Quarantine</div>
                        </a>
                    </li>

                    <!-- Approvals -->
                    <li>
                        <a href="/Approvals" class="<%= typeof activeNav !== 'undefined' && activeNav === 'approvals' ? 'active' : '' %>" title="Four-Eyes Approvals">
                            <div class="app-card">
                                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="app-label">Approvals</div>
                        </a>
                    </li>

                    <!-- Endpoints -->
                    <li>
                        <a href="/Endpoints" class="<%= typeof activeNav !== 'undefined' && activeNav === 'endpoints' ? 'active' : '' %>" title="Endpoints">
                            <div class="app-card">
                                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
                                </svg>
                            </div>
                            <div class="app-label">Endpoints</div>
                        </a>
                    </li>

                    <!-- Encryption -->
                    <li>
                        <a href="/EncryptionProfiles" class="<%= typeof activeNav !== 'undefined' && activeNav === 'encryption' ? 'active' : '' %>" title="Encryption Profiles">
                            <div class="app-card">
                                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </div>
                            <div class="app-label">Crypto</div>
                        </a>
                    </li>

                    <!-- Settings -->
                    <li>
                        <a href="/Settings" class="<%= typeof activeNav !== 'undefined' && activeNav === 'settings' ? 'active' : '' %>" title="System Settings">
                            <div class="app-card">
                                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <div class="app-label">Settings</div>
                        </a>
                    </li>

                    <!-- Audit Log -->
                    <li>
                        <a href="/Audit" class="<%= typeof activeNav !== 'undefined' && activeNav === 'audit' ? 'active' : '' %>" title="Audit Log">
                            <div class="app-card">
                                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                                </svg>
                            </div>
                            <div class="app-label">Audit Log</div>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="fb-sidebar-footer">
                <div class="fb-cluster-status-chip">
                    <span class="fb-pulse-dot"></span>
                    <span>Cluster Online</span>
                </div>
                <a href="/Jobs/Create" class="btn-fb primary sm" style="padding: 4px 8px; font-size: 11px;">
                    + New Job
                </a>
            </div>
        </aside>

        <!-- Main Body Wrapper -->
        <div class="fb-body-wrapper">
            <!-- Top Navigation Bar -->
            <header class="fb-topbar">
                <div class="fb-topbar-left">
                    <div class="fb-breadcrumbs">
                        <a href="/">FileBridge</a>
                        <span>/</span>
                        <span class="fb-breadcrumbs-current"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></span>
                    </div>
                </div>

                <div class="fb-topbar-right">
                    <button type="button" class="fb-search-trigger" id="fb-search-btn" title="Quick Search">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <span>Quick jump...</span>
                        <span class="fb-search-kbd">Ctrl K</span>
                    </button>

                    <div class="fb-user-chip">
                        <div class="fb-user-avatar">AD</div>
                        <span class="fb-user-name"><%= typeof currentUser !== 'undefined' && currentUser ? currentUser : 'AGENCY\\admin' %></span>
                    </div>
                </div>
            </header>

            <!-- Main Content Viewport -->
            <main class="fb-main">
                <% if (typeof flashMessage !== 'undefined' && flashMessage) { %>
                    <div class="fb-flash">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span><%= flashMessage %></span>
                    </div>
                <% } %>
